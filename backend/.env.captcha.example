# Enable only after all four production values are configured.
TENCENT_CAPTCHA_REQUIRED=false
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=

# Tencent Cloud API credentials used only by the backend to call DescribeCaptchaResult.
# Prefer a least-privilege sub-account rather than the root account.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
